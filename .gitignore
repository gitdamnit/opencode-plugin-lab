# Staged, manifest-declared plugin sources (generated by scripts/stage.mjs)
/staging/*
!/staging/.gitkeep

# Locally generated manifests (scripts/test-plugin.sh)
/.lab/

# Build outputs and disposable state
/build/

# Generated reports. The committed historical evidence under reports/historical/
# and the example sample-report.md are kept; everything else is regenerated.
/reports/runs/
/reports/test-report.json
/reports/test-report.md
/reports/test-report-*.json
/reports/runtime-*.json
/reports/load-order-*.json
/reports/matrix-*.json
/reports/failure-isolation-*.json
/reports/install-artifact-*.json
/reports/config-validation-*.json
/reports/rc-evidence.json
/reports/rc-evidence.md
!/reports/historical/
!/reports/historical/**
!/reports/sample-report.md
!/reports/.gitkeep

# Local secrets / overrides
.env
.env.local

# Editor / OS noise
.DS_Store
*.swp

# Installed dependencies (host-side example/staging builds)
node_modules/
