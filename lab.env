# OpenCode Plugin Lab — tunables.
# Edit these, then run `make refresh` (or `make build`) to rebuild.
# This file is part of the Docker build context *only* as documentation; it is
# not baked into the image. Never put credentials here — use ../.env instead.

# Base image for both build and runtime stages.
NODE_IMAGE=node:22-bookworm-slim

# OpenCode V2 CLI and plugin SDK versions come from the active manifest's
# `opencode` block (see lab.config.json / profiles/*/lab.config.json). Set the
# variables below ONLY to override the manifest for a one-off build — they are
# not required, and are deliberately left unset so each manifest stays in
# control of its pinned, reproducible versions.
#
# OPENCODE_VERSION=2.0.21
# PLUGIN_SDK_VERSION=2.0.21
#
# Note: the released V2 line moves quickly (2.0.21 -> 2.0.3x in October 2026).
# Passing a different version here is how you evaluate a newer runtime; it is
# never silently picked up, and the exact version installed is recorded in every
# report.

# Resource limits for the offline test container.
LAB_MEMORY=2g
LAB_CPUS=2.0
LAB_PIDS=512
LAB_WORK_TMPFS=2g
LAB_HOME_TMPFS=256m

# Host uid/gid used to run the container so that ./reports stays writable.
# Defaults to the invoking user; override if your host user differs.
# LAB_UID=1000
# LAB_GID=1000
